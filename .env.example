# Pooled Neon PostgreSQL URL used by the Next.js and Netlify runtime.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER-HOST/DATABASE?sslmode=verify-full&channel_binding=require
# Direct Neon PostgreSQL URL used only by Prisma CLI and the one-time data migration.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT-HOST/DATABASE?sslmode=verify-full&channel_binding=require
TM_BASE_URL=https://www.transfermarkt.com
TM_REQUEST_DELAY_MS=4000
TM_REQUEST_JITTER_MS=2000
TM_BOOTSTRAP_MAX_REQUESTS=500
TM_DAILY_MAX_REQUESTS=100
TM_PROFILE_TTL_DAYS=7
TM_PERFORMANCE_TTL_DAYS=7
